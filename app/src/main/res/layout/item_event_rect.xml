<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_event_rect"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <!-- Строка с названием и бейджем рядом (для коротких событий < 60 мин) -->
    <LinearLayout
        android:id="@+id/layout_short"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_event_title_short"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:ellipsize="end"
            android:maxLines="1"
            android:shrinkColumns="0" />

        <TextView
            android:id="@+id/tv_event_room_short"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_room_badge"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Название для длинных событий >= 60 мин -->
    <TextView
        android:id="@+id/tv_event_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:ellipsize="end"
        android:maxLines="2"
        android:visibility="gone" />

    <!-- Бейдж помещения под названием для длинных событий -->
    <TextView
        android:id="@+id/tv_event_room"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_room_badge"
        android:visibility="gone" />

</LinearLayout>