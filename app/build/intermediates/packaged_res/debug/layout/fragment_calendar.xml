<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimary"
    android:orientation="vertical">

    <!-- Header Blue Part -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:title="" />

        <!-- Toggle View Mode - Moved up and larger -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_group_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="-40dp"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:checkedButton="@+id/tab_month">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tab_month"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:text="Месяц"
                android:textColor="@android:color/white"
                android:strokeColor="@android:color/white"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tab_week"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:text="Неделя"
                android:textColor="@android:color/white"
                android:strokeColor="@android:color/white"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tab_day"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:text="День"
                android:textColor="@android:color/white"
                android:strokeColor="@android:color/white"
                app:strokeWidth="1dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Date Display for Day View (Centered Oval with arrows) -->
        <LinearLayout
            android:id="@+id/layout_day_title_nav"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/btn_prev_day"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:tint="@android:color/white"
                android:contentDescription="Предыдущий день" />

            <TextView
                android:id="@+id/tv_day_view_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_date_oval"
                android:paddingHorizontal="24dp"
                android:paddingVertical="8dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="30 мая, Суббота" />

            <ImageButton
                android:id="@+id/btn_next_day"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_next"
                android:tint="@android:color/white"
                android:contentDescription="Следующий день" />
        </LinearLayout>

        <!-- Navigation Month/Week (Centered Title) -->
        <RelativeLayout
            android:id="@+id/layout_nav_month"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp">

            <ImageButton
                android:id="@+id/btn_prev_month"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:tint="@android:color/white"
                android:contentDescription="Назад" />

            <TextView
                android:id="@+id/tv_month_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                tools:text="Май 2024" />

            <ImageButton
                android:id="@+id/btn_next_month"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_next"
                android:tint="@android:color/white"
                android:contentDescription="Вперед" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Content Area with Rounded Corners -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_white_rounded_top">

        <!-- Month/Week View -->
        <LinearLayout
            android:id="@+id/container_month_week"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/weekdays_row"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">
            </LinearLayout>

            <GridView
                android:id="@+id/grid_calendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:numColumns="7"
                android:stretchMode="columnWidth" />

            <TextView
                android:id="@+id/tv_events_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:text="СЕГОДНЯ" />

            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Нет мероприятий"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_events"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingBottom="80dp"
                android:clipToPadding="false" />
        </LinearLayout>

        <!-- Day Hourly View -->
        <ScrollView
            android:id="@+id/scroll_view_hourly"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/layout_day_schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/container_hours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Red line for current time -->
                <LinearLayout
                    android:id="@+id/view_current_time_indicator"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_current_time_label"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="@android:color/holo_red_dark"
                        android:textStyle="bold"
                        android:background="?attr/colorSurface" />

                    <View
                        android:layout_width="2dp"
                        android:layout_height="12dp"
                        android:background="@android:color/holo_red_dark" />

                    <View
                        android:id="@+id/view_red_line"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginEnd="8dp"
                        android:background="@android:color/holo_red_dark" />
                </LinearLayout>
            </RelativeLayout>
        </ScrollView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_event"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:src="@drawable/ic_add" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_today_floating"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:translationY="100dp"
            android:text="Сегодня"
            android:textColor="?attr/colorPrimary"
            app:elevation="8dp" />

    </FrameLayout>

</LinearLayout>
